APP_ENVIRONMENT=development
DEBUG=false

# Local development HTTP uchun false. Production HTTPS muhitida true bo'lishi shart.
SESSION_COOKIE_NAME=nasiya_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
ANONYMOUS_SESSION_TTL_MINUTES=30
SESSION_TOUCH_INTERVAL_MINUTES=5

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PHONE_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20

# Development namunasi xolos. Productionda real, maxfiy, kamida 32 belgili qiymat bering.
RATE_LIMIT_HMAC_KEY=change-me-local-rate-limit-hmac-key-at-least-32-chars
OTP_HMAC_KEY=
OTP_REGISTRATION_TTL_SECONDS=180
OTP_REGISTRATION_MAX_VERIFY_ATTEMPTS=5
OTP_REGISTRATION_RESEND_COOLDOWN_SECONDS=60
OTP_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900
OTP_REGISTRATION_RATE_LIMIT_PHONE_ATTEMPTS=3
OTP_REGISTRATION_RATE_LIMIT_USER_ATTEMPTS=3
OTP_REGISTRATION_RATE_LIMIT_IP_ATTEMPTS=20

# Optional M10 customer identity crypto bundle. Production values must come
# from an environment/secret manager; never commit key IDs, maps, or material.
CUSTOMER_IDENTITY_ACTIVE_KEY_ID=
CUSTOMER_IDENTITY_ENCRYPTION_KEYS=
CUSTOMER_IDENTITY_BLIND_INDEX_KEY=

# Optional private S3-compatible object storage bundle.
# Web/health bu qiymatlarsiz ishlaydi; storage amali complete bundle talab qiladi.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_USE_SSL=
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_PRESIGNED_TTL_SECONDS=300
OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760
OBJECT_STORAGE_MAX_MULTIPART_BYTES=11010048
OBJECT_STORAGE_MAX_IMAGE_PIXELS=40000000
OBJECT_STORAGE_MAX_IMAGE_DIMENSION=16384
OBJECT_STORAGE_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=900
OBJECT_STORAGE_UPLOAD_RATE_LIMIT_USER_ATTEMPTS=5
OBJECT_STORAGE_UPLOAD_RATE_LIMIT_IP_ATTEMPTS=20
OBJECT_STORAGE_RECONCILE_STALE_SECONDS=60

# Local MinIO runtime. Synthetic development values only; productionda
# provider-managed credentials/secrets ishlating.
MINIO_ROOT_USER=local-minio-root
MINIO_ROOT_PASSWORD=change-me-local-minio-root-secret-at-least-32-chars
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=nasiya-private
MINIO_APP_ACCESS_KEY=local-nasiya-storage-app
MINIO_APP_SECRET_KEY=change-me-local-nasiya-storage-app-secret-at-least-32-chars
MINIO_APP_POLICY_NAME=nasiya-storage-app

# PostgreSQL compose service values
POSTGRES_DB=nasiya
POSTGRES_USER=nasiya
POSTGRES_PASSWORD=dev_pass
POSTGRES_PORT=5432

# Host kompyuterda app ishga tushsa, PostgreSQL published port orqali ulanadi.
DB_HOST_LOCAL=127.0.0.1
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST_LOCAL}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST_LOCAL}:${POSTGRES_PORT}/nasiya_test
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Docker ichidagi app esa compose service hostname va ichki 5432 portdan foydalanadi.
DB_HOST_DOCKER=db
DATABASE_URL_DOCKER=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST_DOCKER}:5432/${POSTGRES_DB}
